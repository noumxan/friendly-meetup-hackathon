# Copy to .env. Never commit .env.
# Defaults below use local Ollama (see compose.yaml). Other providers: docs/providers.md
#
# The published 15/25, 18/25, and 21/25 scorecards used OpenAI, not these defaults:
#   AGENT_BASE_URL=https://api.openai.com/v1
#   AGENT_MODEL=gpt-4.1-mini
#   JUDGE_BASE_URL=https://api.openai.com/v1
#   JUDGE_MODEL=gpt-4.1
# Put the key only in .env. Leave it out of git.

# The agent being tested
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_API_KEY=
AGENT_MODEL=llama3.2:3b

# The judge that grades answers (tip: use a different, stronger model)
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=
JUDGE_MODEL=qwen2.5:7b
